{
  "name": "grain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A taste library. Save design references, extract what makes them work, compose them back into prompts and tokens.",
  "scripts": {
    "grain": "bun run src/cli.ts",
    "add": "bun run src/cli.ts add",
    "ingest": "bun run src/cli.ts ingest",
    "build": "bun run src/cli.ts build",
    "serve": "bun run src/cli.ts serve",
    "demo": "GRAIN_LIBRARY=.demo-library bun run src/cli.ts serve",
    "list": "bun run src/cli.ts list",
    "brief": "bun run src/cli.ts brief",
    "setup:browser": "bunx playwright install chromium",
    "check-types": "tsc --noEmit",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "optionalDependencies": {
    "playwright": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5"
  }
}
