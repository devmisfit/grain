# Required. grain reads this from the environment or from a .env file next to package.json.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# GRAIN_LIBRARY=/absolute/path/to/library   # default: ./library
# GRAIN_MODEL=claude-opus-5                 # default: claude-opus-5
# GRAIN_PORT=4610                           # default: 4610
